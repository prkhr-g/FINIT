{
  "name": "fint",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build --workspace=@fint/web",
    "build:api": "npm run build --workspace=@fint/api",
    "dev:web": "npm run dev --workspace=@fint/web",
    "dev:api": "npm run start:dev --workspace=@fint/api",
    "lint:web": "npm run lint --workspace=@fint/web",
    "test:api": "npm run test --workspace=@fint/api"
  },
  "engines": {
    "node": ">=20"
  }
}
